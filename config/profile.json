{
  "settings": {
    "org.nemo.preferences": {
      "default-folder-viewer": "'list-view'",
      "start-with-dual-pane": "false",
      "show-full-path-titles": "false",
      "show-toggle-extra-pane-toolbar": "true",
      "show-open-in-terminal-toolbar": "true",
      "show-reload-icon-toolbar": "false",
      "thumbnail-limit": "uint64 104857600",
      "date-format": "'informal'",
      "show-compact-view-icon-toolbar": "false",
      "show-edit-icon-toolbar": "false",
      "show-new-folder-icon-toolbar": "true",
      "show-show-thumbnails-toolbar": "true",
      "tooltips-in-icon-view": "true",
      "tooltips-in-list-view": "true",
      "tooltips-show-file-type": "true",
      "tooltips-show-mod-date": "true",
      "tooltips-show-path": "true"
    },
    "org.nemo.list-view": {
      "default-zoom-level": "'small'",
      "enable-folder-expansion": "true",
      "default-column-order": "['name', 'date_modified', 'size', 'type']",
      "default-visible-columns": "['name', 'date_modified', 'size']"
    },
    "org.nemo.window-state": {
      "sidebar-width": "200"
    },
    "org.nemo.icon-view": {
      "thumbnail-size": "96"
    },
    "org.nemo.preferences.menu-config": {
      "selection-menu-copy-to": "true",
      "selection-menu-move-to": "true"
    }
  },
  "search_exclusions": [
    "/dev",
    "/proc",
    "/sys",
    "dosdevices",
    ".git",
    "node_modules",
    ".venv",
    "venv",
    "__pycache__",
    ".cache",
    ".gradle",
    ".dart_tool",
    ".pytest_cache",
    ".mypy_cache",
    ".ruff_cache",
    ".next"
  ],
  "folder_icons": {
    "Projects": "/usr/share/icons/Yaru-blue/256x256/places/folder.png",
    "Work": "/usr/share/icons/Yaru-purple/256x256/places/folder-documents.png"
  }
}
